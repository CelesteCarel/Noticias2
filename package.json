{
  "name": "portal-de-noticias",
  "version": "1.0.0",
  "description": "Portal de Noticias con RBAC Dinámico y Auditoría",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "certs": "node --no-warnings scripts/generate-certs.js",
    "keys": "node --no-warnings scripts/generate-jwt-keys.js",
    "backup": "node --no-warnings scripts/backup.js",
    "demo": "node --no-warnings scripts/demo-cripto.js",
    "demo:cifrado": "node --no-warnings scripts/demo-cifrado.js",
    "demo:asimetrico": "node --no-warnings scripts/demo-asimetrico.js",
    "demo:firma": "node --no-warnings scripts/demo-firma.js",
    "test": "node --no-warnings test/crypto.test.js && node --no-warnings test/config.test.js && node --no-warnings test/backup.test.js && node --no-warnings test/api.test.js",
    "test:crypto": "node --no-warnings test/crypto.test.js",
    "test:api": "node --no-warnings test/api.test.js",
    "test:config": "node --no-warnings test/config.test.js",
    "test:backup": "node --no-warnings test/backup.test.js"
  },
  "keywords": [
    "noticias",
    "rbac",
    "auditoria",
    "express",
    "sqlite",
    "jwt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13"
  }
}
