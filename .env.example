# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Genera valores propios con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=tu_clave_secreta_jwt_para_tokens_de_acceso
JWT_REFRESH_SECRET=tu_clave_secreta_para_refresh_tokens

# ─── Contraseñas iniciales de los usuarios seed ───────────────────────────────
# Solo se usan si la base de datos aún no tiene usuarios.
# Deben tener al menos 8 caracteres y no coincidir con los valores de ejemplo.
DEFAULT_ADMIN_PASSWORD=cambia-esta-clave-inicial-admin
DEFAULT_EDITOR_PASSWORD=cambia-esta-clave-inicial-editor
DEFAULT_REGULAR_PASSWORD=cambia-esta-clave-inicial-lector

# ─── Base de datos (opcional) ─────────────────────────────────────────────────
# DB_PATH=./database.sqlite

# ─── CORS (orígenes permitidos separados por coma) ───────────────────────────
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ─── HTTPS (desactivado por defecto en desarrollo) ───────────────────────────
HTTPS_ENABLED=false
# TLS_KEY_PATH=./certs/dev-key.pem
# TLS_CERT_PATH=./certs/dev-cert.pem

# ─── SMTP (opcional – si se omite, usa Ethereal en modo prueba) ───────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_contraseña_de_aplicacion
