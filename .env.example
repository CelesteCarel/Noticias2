# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT (firma asimétrica RS256) ────────────────────────────────────────────
# Las llaves NO se versionan. Genéralas con: npm run keys
# Luego colócalas en keys/ (ignorada por git) y deja estas rutas:
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem

# ─── Contraseñas iniciales de los usuarios seed ───────────────────────────────
# Solo se usan si la base de datos aún no tiene usuarios.
# Deben tener al menos 8 caracteres y no coincidir con los valores de ejemplo.
DEFAULT_ADMIN_PASSWORD=cambia-esta-clave-inicial-admin
DEFAULT_EDITOR_PASSWORD=cambia-esta-clave-inicial-editor
DEFAULT_REGULAR_PASSWORD=cambia-esta-clave-inicial-lector

# ─── Base de datos (opcional) ─────────────────────────────────────────────────
# DB_PATH=./database.sqlite

# ─── CORS (orígenes permitidos separados por coma) ───────────────────────────
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ─── HTTPS (desactivado por defecto en desarrollo) ───────────────────────────
HTTPS_ENABLED=false
# TLS_KEY_PATH=./certs/dev-key.pem
# TLS_CERT_PATH=./certs/dev-cert.pem

# ─── Criptografía de la Aplicación ──────────────────────────────────────────
# Mecanismo 1 (Simétrico): llave de 256 bits (64 caracteres hex) para AES-256-GCM.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca uses el valor de ejemplo ni subas tu .env al repositorio.
DATA_ENCRYPTION_KEY=genera_tu_clave_hexadecimal_de_64_caracteres_aes_256

# Mecanismo 2 (Asimétrico): par RSA de 3072 bits para firmar JWT y noticias.
# Lo genera `npm run keys`; las rutas de arriba apuntan a keys/.

# ─── SMTP (opcional – si se omite, usa Ethereal en modo prueba) ───────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_contraseña_de_aplicacion
