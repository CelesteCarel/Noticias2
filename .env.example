# ============================================================================
# Portal de Noticias UNACH — ejemplo de configuración
# Copia este archivo a .env y cambia TODOS los valores de ejemplo.
# Nunca subas tu .env al repositorio.
# ============================================================================

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT (firma asimétrica RS256) ────────────────────────────────────────────
# Esta versión firma los tokens con un par RSA, no con un secreto compartido.
# Las llaves NO se versionan. Genéralas con: npm run keys
# Luego colócalas en keys/ (ignorada por git) y deja estas rutas:
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem

# JWT_SECRET y JWT_REFRESH_SECRET no se usan en esta arquitectura RS256.
# Se dejan documentadas solo por compatibilidad con despliegues anteriores:
# JWT_SECRET=no_usar_en_esta_version_rs256
# JWT_REFRESH_SECRET=no_usar_en_esta_version_rs256

# ─── Contraseñas iniciales de los usuarios seed ───────────────────────────────
# Solo se usan si la base de datos aún no tiene usuarios.
# Deben tener al menos 8 caracteres y no coincidir con los valores de ejemplo.
DEFAULT_ADMIN_PASSWORD=cambia-esta-clave-inicial-admin
DEFAULT_EDITOR_PASSWORD=cambia-esta-clave-inicial-editor
DEFAULT_REGULAR_PASSWORD=cambia-esta-clave-inicial-lector

# ─── Base de datos y archivos (opcional) ─────────────────────────────────────
# DB_PATH=./database.sqlite
# UPLOAD_DIR=./storage/uploads

# ─── CORS (orígenes permitidos separados por coma) ───────────────────────────
# En la red Intermedia usa la IP o el nombre real del servidor, por ejemplo:
# CORS_ORIGIN=https://192.168.188.10:3000,https://portal.unach.local:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ─── HTTPS (desactivado por defecto en desarrollo) ───────────────────────────
HTTPS_ENABLED=false
# TLS_KEY_PATH=./certs/dev-key.pem
# TLS_CERT_PATH=./certs/dev-cert.pem

# Redirección opcional de HTTP a HTTPS en un segundo puerto.
# Si se define, http://IP:3080 responde 308 hacia https://IP:3000.
# HTTP_REDIRECT_PORT=3080

# Solo para `npm run certs`: IPs y nombres que irán en el Subject Alternative
# Name del certificado. Incluye la IP de la VM de la red Intermedia.
# TLS_IP=192.168.188.10
# TLS_HOSTS=portal.unach.local,localhost

# ─── Criptografía de la Aplicación ──────────────────────────────────────────
# Mecanismo 1 (Simétrico): llave de 256 bits (64 caracteres hex) para AES-256-GCM.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# El servidor se niega a arrancar si falta o si es débil (por ejemplo, todo ceros).
# Nunca uses el valor de ejemplo ni subas tu .env al repositorio.
DATA_ENCRYPTION_KEY=genera_tu_clave_hexadecimal_de_64_caracteres_aes_256

# Mecanismo 2 (Asimétrico): par RSA de 3072 bits para firmar JWT y noticias.
# Lo genera `npm run keys`; las rutas de arriba apuntan a keys/.

# ─── Respaldos diarios a unidad externa ─────────────────────────────────────
# Ruta de la USB o disco extraíble. Ejemplos:
#   Windows: BACKUP_DIR=E:\Respaldos\PortalNoticias
#   Linux:   BACKUP_DIR=/media/usb/portal-noticias
# Si la unidad no está conectada, `npm run backup` falla con un mensaje claro
# y registra el error en logs/backup.log sin detener la aplicación.
BACKUP_DIR=E:\Respaldos\PortalNoticias

# Cuántos respaldos completos se conservan (el más antiguo se elimina).
BACKUP_RETENTION=7

# Directorio del log del respaldo (opcional, por defecto ./logs).
# BACKUP_LOG_DIR=./logs

# ─── SMTP (opcional – si se omite, usa Ethereal en modo prueba) ───────────────
# Gmail: activa la verificación en dos pasos y crea una "Contraseña de
# aplicación" de 16 caracteres; NO uses tu contraseña normal de Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop

# Remitente que verán los usuarios en el correo de recuperación.
# EMAIL_FROM="Portal de Noticias UNACH" <no-reply@portalnoticias.edu.mx>

# ─── Opciones avanzadas ──────────────────────────────────────────────────────
# TRUST_PROXY=true solo si la app está detrás de un proxy de confianza (OPNsense,
# Nginx). Si se activa sin proxy, un cliente podría falsificar su IP en auditoría.
# TRUST_PROXY=false

# Límites de peticiones por ventana (útil para pruebas de carga).
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_AUTH_MAX=20
